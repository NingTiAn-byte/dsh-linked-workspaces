{
  "name": "@local/dsh-linked-workspaces",
  "version": "0.3.0",
  "type": "module",
  "description": "Primary and linked project directories for DeepSeek Harness",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-alpha.4 || 0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:live": "node tests/live.mjs",
    "test:host": "node --import ./scripts/host-sdk-loader.mjs --test --test-isolation=none tests/*.test.mjs",
    "test:quick": "node tests/quick-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2 || ~4.0.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.4 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.4 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2 || ~3.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "playwright": "1.61.1",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NingTiAn-byte/dsh-linked-workspaces.git"
  },
  "homepage": "https://github.com/NingTiAn-byte/dsh-linked-workspaces#readme",
  "bugs": {
    "url": "https://github.com/NingTiAn-byte/dsh-linked-workspaces/issues"
  },
  "author": "NingTiAn-byte",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workspaces",
    "multi-repo"
  ]
}
